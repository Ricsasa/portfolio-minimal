---
interface Props {
    title: string;
    skills: string[];
}

const { title, skills } = Astro.props;
---

<div class="bg-white/50 p-6 col-span-4 flex flex-col gap-4">
    <h3 class="text-xl font-bold text-black-tertiary">{title}</h3>

    <div class="flex flex-wrap gap-1.5">
        {
            skills.map((skill) => (
                <span class="text-xs bg-custom-purple-300 text-black-tertiary px-2.5 py-1">
                    {skill}
                </span>
            ))
        }
    </div>
</div>
