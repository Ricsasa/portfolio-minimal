---
interface Props {
    title: string;
    skills: string[];
}

const { title, skills } = Astro.props;
---

<div class="card col-span-4 flex flex-col gap-4">
    <h3 class="text-xl font-bold text-black-tertiary">{title}</h3>

    <div class="flex flex-wrap gap-1.5">
        {
            skills.map((skill) => (
                <span class="tag bg-custom-purple-100 text-black-tertiary">
                    {skill}
                </span>
            ))
        }
    </div>
</div>
