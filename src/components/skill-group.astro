---
interface Props {
    title: string;
    skills: string[];
}

const { title, skills } = Astro.props;
---

<div>
    <h3 class="text-xs font-bold uppercase text-black-secondary mb-2.5">
        {title}
    </h3>
    <div class="flex flex-wrap gap-2">
        {
            skills.map((skill) => (
                <span class="text-[13px] bg-white/60 text-black-tertiary px-3 py-1">
                    {skill}
                </span>
            ))
        }
    </div>
</div>
