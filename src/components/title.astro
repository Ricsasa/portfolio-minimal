---
const { title } = Astro.props;
---

<div class="md:col-span-3 items-center mb-12 md:mb-36">
    {
        title && (
            <h1 class="font-sans text-5xl font-bold tracking-[-0.03em] md:text-6xl border-b border-(--section-accent) pb-6">
                {title}
            </h1>
        )
    }
</div>
