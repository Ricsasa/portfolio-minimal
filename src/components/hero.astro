---
import sharp from "sharp";
import path from "node:path";

interface Props {
	accentColor?: string;
}

const { accentColor = "pine" } = Astro.props;

const screenshots = [
	...Array.from({ length: 4 }, (_, i) => `/projects/lumina-admin/${i + 1}.avif`),
	...Array.from({ length: 8 }, (_, i) => `/projects/lumina-landing/${i + 1}.avif`),
];

// Real aspect ratio of every file, read once at build time.
const measured = await Promise.all(
	screenshots.map(async (src) => {
		const { width = 1, height = 1 } = await sharp(path.join(process.cwd(), "public", src)).metadata();

		return { src, ratio: width / height };
	}),
);

// Portrait shots stand full height, landscape shots sit lower, so the strip
// staggers on its own without cropping anything.
const heightFor = (ratio: number) => (ratio < 0.8 ? 100 : ratio < 1.1 ? 76 : ratio < 1.6 ? 58 : 46);

// Alternate portrait and landscape instead of shuffling, to keep the tall
// images spread across the strip.
const portrait = measured.filter((image) => image.ratio < 1);
const landscape = measured.filter((image) => image.ratio >= 1);
const step = Math.max(1, Math.floor(landscape.length / (portrait.length || 1)));

const carouselImages = landscape.flatMap((image, i) => {
	const tall = (i + 1) % step === 0 ? portrait[(i + 1) / step - 1] : undefined;

	return tall ? [image, tall] : [image];
});

carouselImages.push(...portrait.slice(carouselImages.length - landscape.length));
---

<style>
	.hero-title {
		font-size: clamp(2.5rem, 14vw, 7rem);
	}
	@media (max-width: 768px) {
		.hero-title {
			font-size: clamp(1.8rem, 15vw, 5rem);
		}
	}
	.hero-carousel {
		height: clamp(34svh, 48svh, 560px);
	}

	.hero-carousel-track {
		height: 100%;
		width: max-content;
		gap: clamp(0.5rem, 1.5vw, 1rem);
		padding: 0 clamp(0.5rem, 1.5vw, 1rem);
		animation: hero-carousel-scroll 60s linear infinite;
		clip-path: inset(-100% 0 -100% 0);
	}

	@media (hover: hover) and (pointer: fine) {
		.hero-carousel:hover .hero-carousel-track {
			animation-play-state: paused;
		}
	}

	.hero-carousel-img {
		transition: filter 0.3s ease, transform 0.3s ease, margin 0.3s ease;
	}

	.hero-carousel-img {
		transform-origin: bottom center;
	}

	.hero-device {
		box-sizing: border-box;
		position: relative;
		display: flex;
		border: 1px solid #d9d9d9;
		background: #f2f2f2;
		overflow: hidden;
	}

	.hero-device img {
		transition: filter 0.3s ease;
	}

	.hero-device-detail {
		position: absolute;
		background: #d9d9d9;
		border-radius: 999px;
	}

	.hero-device-phone {
		border-radius: 0.9rem;
		padding: 0.4rem 0.3rem;
	}

	/* Speaker slit. */
	.hero-device-phone .hero-device-detail {
		top: 0.16rem;
		left: 50%;
		transform: translateX(-50%);
		width: 18%;
		height: 0.09rem;
	}

	.hero-device-phone img {
		border-radius: 0.55rem;
	}

	.hero-device-monitor {
		border-radius: 0.35rem;
		padding: 0.3rem 0.3rem 0.75rem;
	}

	/* Chin dot. */
	.hero-device-monitor .hero-device-detail {
		bottom: 0.28rem;
		left: 50%;
		transform: translateX(-50%);
		width: 0.2rem;
		height: 0.2rem;
	}

	.hero-device-monitor img {
		border-radius: 0.12rem;
	}

	@media (hover: hover) and (pointer: fine) {
		/* The grayscale sits on the inner image, inside the device frame. */
		.hero-carousel:hover .hero-carousel-img:hover img {
			filter: grayscale(0);
		}

		.hero-carousel:hover .hero-carousel-img:hover {
			transform: scale(1.2);
			margin: 0 3rem;
			position: relative;
			z-index: 1;
		}
	}

	@keyframes hero-carousel-scroll {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-carousel-track {
			animation: none;
		}
	}

	.hero-anim-title,
	.hero-anim-subtitle,
	.hero-anim-image {
		opacity: 0;
	}

	.hero-anim-title {
		animation: hero-fade-up 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
	}
	.hero-anim-subtitle {
		animation: hero-fade-up 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.35s forwards;
	}
	.hero-anim-image {
		animation: hero-image-in 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
	}

	@keyframes hero-fade-up {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes hero-image-in {
		from {
			opacity: 0;
			transform: translateY(24px) scale(0.97);
		}
		to {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-anim-title,
		.hero-anim-subtitle,
		.hero-anim-image {
			animation: none;
			opacity: 1;
			transform: none;
		}
	}
</style>

<div class="relative w-full h-dvh flex flex-col items-center" style="padding: clamp(3rem, 10vh, 6rem) clamp(1rem, 5vw, 3rem) 0;">
	<div class="flex flex-col items-center text-center w-full" style="gap: clamp(0.75rem, 2vh, 1.5rem);">
		<h1 class="hero-title hero-anim-title font-sans font-black uppercase tracking-tighter leading-none flex justify-center flex-wrap m-0" style="gap: clamp(0.25rem, 2vw, 0.5rem); color: transparent; -webkit-text-stroke: clamp(1px, 0.15vw, 2px) var(--color-pine);">
			Ricardo<span style="color: var(--color-pine);">Sánchez</span>
		</h1>

		<p class="hero-anim-subtitle m-0 font-bold uppercase tracking-widest" style="font-size: clamp(0.6rem, 1.8vw, 0.85rem); color: var(--color-iris);">Full Stack Engineer</p>
	</div>

	<div class="hero-carousel hero-anim-image absolute bottom-0 left-1/2 -translate-x-1/2 w-screen">
		<div class="hero-carousel-track flex items-end">
			{
				[...carouselImages, ...carouselImages].map(({ src, ratio }) => {
					const isPhone = ratio < 1;

					return (
						<div class={`hero-carousel-img hero-device ${isPhone ? "hero-device-phone" : "hero-device-monitor"} flex-shrink-0`} style={`height: ${heightFor(ratio)}%; aspect-ratio: ${ratio};`}>
							<span class="hero-device-detail" />
							<img src={src} alt="" class="w-full h-full object-cover grayscale" loading="eager" />
						</div>
					);
				})
			}
		</div>
	</div>

</div>
