---
import i18n from "i18next";
import { Image } from "astro:assets";
import Subject from "../assets/Subject.png";

interface Props {
	accentColor?: string;
}

const { accentColor = "custom-yellow-300" } = Astro.props;
---

<div class="hero-container">
	<div class="hero-top">
		<h1 class="hero-title">
			<span class="hero-first-name">Ricardo</span>
			<span class="hero-last-name">Sánchez</span>
		</h1>

		<p class="hero-role">Full Stack Engineer</p>
	</div>

	<div class="hero-image-wrapper">
		<Image
			src={Subject}
			alt="Ricardo"
			class="hero-image"
		/>
	</div>

	<p class="hero-summary reveal">
		{i18n.t("summary-text")}
	</p>
</div>

<style>
	.hero-container {
		position: relative;
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 1rem 2rem 0;
		gap: 0;
	}

	.hero-top {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		align-items: center;
		text-align: center;
		width: 100%;
		padding-bottom: 1rem;
	}

	.hero-title {
		font-size: clamp(3.5rem, 14vw, 7rem);
		font-weight: 900;
		letter-spacing: -0.02em;
		text-transform: uppercase;
		margin: 0;
		font-family: var(--font-sans);
		display: flex;
		justify-content: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.hero-first-name {
		color: transparent;
		-webkit-text-stroke: 2px var(--color-black-primary);
	}

	.hero-last-name {
		color: var(--color-black-primary);
		font-weight: 900;
	}

	.hero-role {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.15em;
		color: var(--color-black-secondary);
		margin: 0;
		font-weight: 700;
	}

	.hero-image-wrapper {
		width: 80vw;
		max-width: 800px;
		height: 80vh;
		max-height: 800px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.hero-image {
		width: 100%;
		height: 100%;
		object-fit: contain;
		filter: grayscale(100%) drop-shadow(0 8px 24px rgba(0, 0, 0, 0.12));
		transition: filter 300ms ease-out, transform 300ms ease-out;
	}

	.hero-image-wrapper:hover .hero-image {
		filter: grayscale(0%) drop-shadow(0 12px 32px rgba(0, 0, 0, 0.16));
		transform: translateY(-8px);
	}

	.hero-summary {
		font-size: 1.25rem;
		line-height: 1.8;
		color: var(--color-black-secondary);
		margin: 0;
		max-width: 700px;
		text-align: center;
		padding: 2rem 0 2rem;
		width: 100%;
	}

	@media (max-width: 1024px) {
		.hero-image-wrapper {
			height: 50vh;
		}

		.hero-summary {
			font-size: 1.1rem;
		}
	}

	@media (max-width: 640px) {
		.hero-container {
			padding: 0 1rem 0;
			gap: 0;
		}

		.hero-title {
			font-size: clamp(2.5rem, 10vw, 3.5rem);
		}

		.hero-top {
			padding-bottom: 0;
		}

		.hero-image-wrapper {
			height: 65vh;
			margin: 0;
		}

		.hero-summary {
			font-size: 1rem;
			padding: 1.5rem 0 1rem;
		}
	}
</style>
