---
import i18n from "i18next";
import { Image } from "astro:assets";
import Me from "../assets/me.avif";

interface Props {
	accentColor?: string;
}

const { accentColor = "custom-yellow-300" } = Astro.props;
---

<div class="hero-container">
	<div class="hero-content">
		<div class="hero-text">
			<h1 class="hero-title">
				{i18n.t("hi-label")}
			</h1>
			<p class="hero-subtitle">
				{i18n.t("summary-text")}
			</p>
		</div>

		<div class="hero-image-wrapper">
			<Image
				src={Me}
				alt="Ricardo"
				class="hero-image"
				format="avif"
			/>
		</div>

		<div class="hero-meta">
			<p class="hero-role">
				Full Stack Engineer
			</p>
		</div>
	</div>
</div>

<style define:vars={{ accentColor: `var(--color-${accentColor})` }}>
	.hero-container {
		position: relative;
		width: 100%;
		min-height: 60vh;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.hero-content {
		position: relative;
		width: 100%;
		max-width: 100%;
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;
		align-items: center;
	}

	.hero-title {
		font-size: clamp(3rem, 10vw, 6rem);
		line-height: 1.1;
		font-weight: 900;
		letter-spacing: -0.02em;
		text-transform: uppercase;
		margin: 0 0 1rem 0;
		font-family: var(--font-serif);
		color: var(--color-black-primary);
		text-shadow:
			-2px -2px 0 rgba(255, 255, 255, 0.5),
			2px -2px 0 rgba(255, 255, 255, 0.5),
			-2px 2px 0 rgba(255, 255, 255, 0.5),
			2px 2px 0 rgba(255, 255, 255, 0.5);
	}

	.hero-subtitle {
		font-size: 1.125rem;
		line-height: 1.75;
		color: var(--color-black-secondary);
		max-width: 500px;
		margin: 1rem 0 0 0;
	}

	.hero-text {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.hero-image-wrapper {
		position: relative;
		width: 100%;
		max-width: 400px;
		aspect-ratio: 1;
		margin: 2rem auto 0;
	}

	.hero-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 1rem;
		filter: grayscale(100%);
		transition: filter 400ms cubic-bezier(0.16, 1, 0.3, 1);
		will-change: filter;
	}

	.hero-image-wrapper:hover .hero-image {
		filter: grayscale(0%);
	}

	.hero-meta {
		margin-top: 2rem;
	}

	.hero-role {
		font-size: 0.875rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-black-secondary);
		margin: 0;
		font-weight: 600;
	}

	/* Desktop: side-by-side layout */
	@media (min-width: 768px) {
		.hero-content {
			grid-template-columns: 1fr 1fr;
			gap: 4rem;
			align-items: center;
		}

		.hero-image-wrapper {
			margin: 0;
			order: 2;
		}

		.hero-text {
			order: 1;
		}

		.hero-meta {
			grid-column: 1;
			margin-top: 3rem;
		}
	}

	/* Outlined text effect with accent color on hover */
	.hero-title {
		background: linear-gradient(
			135deg,
			transparent 0%,
			transparent 48%,
			var(--header-accent, var(--color-custom-yellow-300)) 48%,
			var(--header-accent, var(--color-custom-yellow-300)) 52%,
			transparent 52%,
			transparent 100%
		);
		background-size: 200% 100%;
		background-position: 100% 0;
		transition: background-position 600ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.hero-container:hover .hero-title {
		background-position: 0 0;
	}
</style>
