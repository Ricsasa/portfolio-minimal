---
import i18n from "i18next";

export interface Project {
    name: string;
    activities: string[];
    technologies: string[];
    achievements?: string | string[];
}

export interface Experience {
    role: string;
    company?: string;
    years: string;
    projects: Project[];
    additionalActivities?: string[];
}

type Props = Experience;

const { role, company, years, projects, additionalActivities } = Astro.props;

const toList = (value?: string | string[]) =>
    value === undefined ? [] : Array.isArray(value) ? value : [value];
---

<div class="card col-span-4 flex flex-col gap-4">
    <div>
        <div class="text-xs text-black-secondary">
            {company ? `${company} · ${years}` : years}
        </div>
        <h3 class="text-xl font-bold text-black-tertiary">{role}</h3>
    </div>

    <ul class="list-disc pl-4.5 flex flex-col gap-3">
        {
            projects.map((project) => (
                <li class="text-[13px] text-black-tertiary">
                    <span class="font-bold">{project.name}</span>
                    <details class="mt-1 pl-4.5">
                        <summary class="-mx-1 cursor-pointer select-none rounded px-1 font-bold transition-colors duration-300 marker:text-black-secondary hover:bg-(--section-accent)">
                            {i18n.t("experience.activities-label")} ({project.activities.length})
                        </summary>
                        <ul class="list-[circle] pl-4.5 mt-1 flex flex-col gap-1">
                            {project.activities.map((activity) => (
                                <li>{activity}</li>
                            ))}
                        </ul>
                    </details>
                    <ul class="list-[circle] pl-4.5 mt-1 flex flex-col gap-1">
                        <li>
                            <span class="font-bold">
                                {i18n.t("experience.technologies-label")}:
                            </span>{" "}
                            {project.technologies.join(", ")}
                        </li>
                        {toList(project.achievements).map((achievement) => (
                            <li>
                                <span class="font-bold">
                                    {i18n.t("experience.achievements-label")}:
                                </span>{" "}
                                {achievement}
                            </li>
                        ))}
                    </ul>
                </li>
            ))
        }
    </ul>

    {
        additionalActivities && additionalActivities.length > 0 && (
            <details>
                <summary class="-mx-1 mb-2.5 cursor-pointer select-none rounded px-1 text-xs font-bold uppercase text-black-secondary transition-colors duration-300 hover:bg-(--section-accent)">
                    {i18n.t("experience.additional-activities-label")} ({additionalActivities.length})
                </summary>
                <ul class="list-disc pl-4.5 mt-2.5 flex flex-col gap-1">
                    {additionalActivities.map((activity) => (
                        <li class="text-[13px] text-black-tertiary">
                            {activity}
                        </li>
                    ))}
                </ul>
            </details>
        )
    }
</div>
