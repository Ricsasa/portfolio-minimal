---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

/**
 * List-item card for the blog index, built on the shared `.card` surface.
 * The title is a "stretched link" covering the whole card; tag pills are
 * separate real links stacked above it via z-index, since anchors cannot nest.
 * Colors are left as plain defaults — final visual design happens separately.
 */
interface Props {
    post: CollectionEntry<"blog">;
    href: string;
    /** Localized blog index pathname, used to build `?tag=` links for each tag pill. */
    tagsIndexHref?: string;
}

const { post, href, tagsIndexHref } = Astro.props;
const { title, description, pubDate, tags = [], cover, coverAlt } = post.data;

const dateFormatter = new Intl.DateTimeFormat(undefined, {
    year: "numeric",
    month: "long",
    day: "numeric",
});
---

<div class="card relative flex flex-col gap-3">
    {
        cover && (
            <Image
                src={cover}
                alt={coverAlt ?? ""}
                class="aspect-video w-full rounded-lg object-cover"
            />
        )
    }
    <div class="text-xs text-black-secondary">
        <time datetime={pubDate.toISOString()}>{dateFormatter.format(pubDate)}</time>
    </div>
    <h3 class="text-xl font-bold text-black-tertiary">
        <a href={href} class="static after:absolute after:inset-0">
            {title}
        </a>
    </h3>
    <p class="text-sm text-black-secondary">{description}</p>
    {
        tags.length > 0 && (
            <div class="relative flex flex-wrap gap-1.5">
                {tags.map((tag) =>
                    tagsIndexHref ? (
                        <a
                            href={`${tagsIndexHref}?tag=${encodeURIComponent(tag)}`}
                            class="tag relative z-10 bg-custom-cream-100 text-black-tertiary transition hover:bg-black-tertiary hover:text-white"
                        >
                            {tag}
                        </a>
                    ) : (
                        <span class="tag bg-custom-cream-100 text-black-tertiary">{tag}</span>
                    ),
                )}
            </div>
        )
    }
</div>
