---
import i18n from "i18next";
import { getLocalizedPathname } from "astro-react-i18next/utils";

import { renderMarkdown } from "../utils/markdown";
import { resolveScreenshots } from "../utils/screenshots";
import { slugify } from "../utils/slugify";
import Carousel from "./carousel.astro";

export interface Project {
    title: string;
    brief_description: string;
    full_description?: string;
    category: string;
    year: string;
    technologies?: string[];
    "screenshots-prefix"?: string;
}

/**
 * `compact` selects how much of the project is shown, not how it is laid out.
 * The layout is the same sticky rail everywhere, so the detail page reads as a
 * longer version of the row on the home page rather than a different design.
 */
type Props = Project & { linkToDetail?: boolean; compact?: boolean };

const {
    title,
    brief_description,
    full_description,
    category,
    year,
    technologies = [],
    "screenshots-prefix": screenshotsPrefix,
    linkToDetail = true,
    compact = false,
} = Astro.props;

const screenshots = resolveScreenshots(screenshotsPrefix);
const fullDescriptionHtml = renderMarkdown(full_description);
const slug = slugify(title);
const carouselId = `screenshots-${slug}`;
const detailHref = getLocalizedPathname(`/projects/${slug}`, i18n.language);
---

<div class="group relative w-full md:col-span-12 flex flex-col gap-6 border-t border-border-rule pt-10 md:grid md:grid-cols-12 md:gap-10 md:items-start">
    {/* Overlay link: the whole row opens the detail page. */}
    {
        linkToDetail && (
            <a
                href={detailHref}
                aria-label={title}
                class="absolute inset-0 z-10 after:hidden"
            />
        )
    }

    {/* The identity rail holds while the body scrolls past it. */}
    <div class="flex flex-col gap-3 md:col-span-4 md:sticky md:top-24">
        <div class="text-xs uppercase tracking-[0.08em] text-iris">
            {category} · {year}
        </div>

        <h3
            class:list={[
                "font-bold text-black-tertiary tracking-[-0.02em]",
                compact ? "text-2xl md:text-3xl" : "text-3xl md:text-4xl",
            ]}
        >
            {title}
        </h3>

        {
            technologies.length > 0 && (
                <div class="flex flex-wrap gap-1.5 pt-1">
                    {technologies.map((technology) => (
                        <span class="tag bg-iris-soft text-iris">{technology}</span>
                    ))}
                </div>
            )
        }

        {
            linkToDetail && (
                <a href={detailHref} data-row-cta class="relative z-20 self-start text-sm text-pine">
                    {i18n.t("projects:details-label")}
                </a>
            )
        }
    </div>

    <div class="flex flex-col gap-6 md:col-span-8">
        <p class:list={["text-black-tertiary", compact ? "text-xs" : "text-base"]}>
            {brief_description}
        </p>

        {
            !compact && fullDescriptionHtml && (
                <div class="flex flex-col gap-2.5" set:html={fullDescriptionHtml} />
            )
        }

        {
            compact
                ? screenshots.length > 0 && (
                      <img
                          src={screenshots[0]}
                          alt={title}
                          class="w-full rounded-lg grayscale hover:grayscale-0 transition-[filter] duration-300"
                      />
                  )
                : screenshots.length > 0 && (
                      <Carousel
                          id={carouselId}
                          images={screenshots.map((screenshot, position) => ({
                              src: screenshot,
                              alt: `${title} - ${i18n.t(
                                  "common:projects.screenshot-alt",
                                  {
                                      index: position + 1,
                                      total: screenshots.length,
                                  },
                              )}`,
                          }))}
                          label={i18n.t("common:projects.screenshots-label")}
                          labels={{
                              previous: i18n.t("common:projects.previous-label"),
                              next: i18n.t("common:projects.next-label"),
                              goTo: (index) =>
                                  i18n.t("common:projects.go-to-label", { index }),
                              open: i18n.t("common:projects.open-label"),
                              close: i18n.t("common:projects.close-label"),
                          }}
                      />
                  )
        }
    </div>
</div>
