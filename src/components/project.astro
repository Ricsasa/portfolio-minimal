---
import i18n from "i18next";
import { getLocalizedPathname } from "astro-react-i18next/utils";

import { renderMarkdown } from "../utils/markdown";
import { resolveScreenshots } from "../utils/screenshots";
import { slugify } from "../utils/slugify";
import Carousel from "./carousel.astro";

export interface Project {
    title: string;
    brief_description: string;
    full_description?: string;
    category: string;
    year: string;
    href?: string;
    cta?: string;
    technologies?: string[];
    "screenshots-prefix"?: string;
}

type Props = Project & { linkToDetail?: boolean; compact?: boolean };

const {
    title,
    brief_description,
    full_description,
    category,
    year,
    href,
    cta,
    technologies = [],
    "screenshots-prefix": screenshotsPrefix,
    linkToDetail = true,
    compact = false,
} = Astro.props;

const screenshots = resolveScreenshots(screenshotsPrefix);
const fullDescriptionHtml = renderMarkdown(full_description);
const slug = slugify(title);
const carouselId = `screenshots-${slug}`;
const detailHref = getLocalizedPathname(`/projects/${slug}`, i18n.language);
---

<div class="card col-span-8 col-start-3 flex flex-col gap-4">
    <div>
        <div class="text-xs text-black-secondary">{category} · {year}</div>
        <h3 class="text-xl font-bold text-black-tertiary">{title}</h3>
    </div>

    <div class="flex flex-col gap-2.5">
        <p class="text-xs text-black-tertiary">
            {brief_description}
        </p>
        {
            !compact && fullDescriptionHtml && (
                <div
                    class="flex flex-col gap-2.5"
                    set:html={fullDescriptionHtml}
                />
            )
        }
    </div>

    {
        compact
            ? screenshots.length > 0 && (
                  <img
                      src={screenshots[0]}
                      alt={title}
                      class="w-full rounded-lg"
                  />
              )
            : screenshots.length > 0 && (
                  <Carousel
                      id={carouselId}
                      images={screenshots.map((screenshot, position) => ({
                          src: screenshot,
                          alt: `${title} \u2014 ${i18n.t(
                              "common:projects.screenshot-alt",
                              {
                                  index: position + 1,
                                  total: screenshots.length,
                              },
                          )}`,
                      }))}
                      label={i18n.t("common:projects.screenshots-label")}
                      labels={{
                          previous: i18n.t("common:projects.previous-label"),
                          next: i18n.t("common:projects.next-label"),
                          goTo: (index) =>
                              i18n.t("common:projects.go-to-label", { index }),
                          open: i18n.t("common:projects.open-label"),
                          close: i18n.t("common:projects.close-label"),
                      }}
                  />
              )
    }

    {
        technologies.length > 0 && (
            <div class="flex flex-wrap gap-1.5">
                {technologies.map((technology) => (
                    <span class="tag bg-custom-green-100 text-black-tertiary">
                        {technology}
                    </span>
                ))}
            </div>
        )
    }

    {
        !compact && href && cta && (
            <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                class="self-start text-sm text-black-primary underline"
            >
                {cta} ↗
            </a>
        )
    }

    {
        linkToDetail && (
            <a href={detailHref} class="self-start text-sm text-black-primary underline">
                {i18n.t("projects:details-label")}
            </a>
        )
    }
</div>
