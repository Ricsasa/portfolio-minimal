---
import i18n from "i18next";

import { renderMarkdown } from "../utils/markdown";
import { resolveScreenshots } from "../utils/screenshots";
import Carousel from "./carousel.astro";

export interface Project {
    title: string;
    brief_description: string;
    full_description?: string;
    category: string;
    year: string;
    href?: string;
    cta?: string;
    technologies?: string[];
    "screenshots-prefix"?: string;
}

type Props = Project;

const {
    title,
    brief_description,
    full_description,
    category,
    year,
    href,
    cta,
    technologies = [],
    "screenshots-prefix": screenshotsPrefix,
} = Astro.props;

const screenshots = resolveScreenshots(screenshotsPrefix);
const fullDescriptionHtml = renderMarkdown(full_description);
const carouselId = `screenshots-${title
    .toLowerCase()
    .normalize("NFD")
    .replace(new RegExp(String.raw`\p{M}`, "gu"), "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "")}`;
---

<div class="card col-span-4 flex flex-col gap-4">
    <div>
        <div class="text-xs text-black-secondary">{category} · {year}</div>
        <h3 class="text-xl font-bold text-black-tertiary">{title}</h3>
    </div>

    <div class="flex flex-col gap-2.5">
        <p class="text-xs text-black-tertiary">
            {brief_description}
        </p>
        {
            fullDescriptionHtml && (
                <div
                    class="flex flex-col gap-2.5"
                    set:html={fullDescriptionHtml}
                />
            )
        }
    </div>

    {
        screenshots.length > 0 && (
            <Carousel
                id={carouselId}
                images={screenshots.map((screenshot, position) => ({
                    src: screenshot,
                    alt: `${title} \u2014 ${i18n.t(
                        "common:projects.screenshot-alt",
                        {
                            index: position + 1,
                            total: screenshots.length,
                        },
                    )}`,
                }))}
                label={i18n.t("common:projects.screenshots-label")}
                labels={{
                    previous: i18n.t("common:projects.previous-label"),
                    next: i18n.t("common:projects.next-label"),
                    goTo: (index) =>
                        i18n.t("common:projects.go-to-label", { index }),
                    open: i18n.t("common:projects.open-label"),
                    close: i18n.t("common:projects.close-label"),
                }}
            />
        )
    }

    {
        technologies.length > 0 && (
            <div class="flex flex-wrap gap-1.5">
                {technologies.map((technology) => (
                    <span class="tag bg-custom-green-100 text-black-tertiary">
                        {technology}
                    </span>
                ))}
            </div>
        )
    }

    {
        href && cta && (
            <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                class="self-start text-sm text-black-primary underline"
            >
                {cta} ↗
            </a>
        )
    }
</div>
