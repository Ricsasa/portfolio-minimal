---
import i18n from "i18next";
import { getLocaleConfig, getLocalizedPathname } from "astro-react-i18next/utils";

import Layout from "../../../layouts/Layout.astro";
import Section from "../../../components/section.astro";
import ExperienceAstroComponent from "../../../components/experience.astro";
import type { Experience } from "../../../components/experience.astro";

export async function getStaticPaths() {
    const EXPERIENCE_KEYS = ["sabbatical", "salesloft", "tiempo", "epam"] as const;
    const { defaultLocale, locales, prefixDefaultLocale } = getLocaleConfig();

    return locales.flatMap((locale: string) => {
        const t = i18n.getFixedT(locale, "professional-experiences");

        return EXPERIENCE_KEYS.map((slug) => ({
            params: {
                locale: locale !== defaultLocale || prefixDefaultLocale ? locale : undefined,
                slug,
            },
            props: { experience: t(slug, { returnObjects: true }) as Experience },
        }));
    });
}

const { experience } = Astro.props;
const experienceHref = getLocalizedPathname("/#professional-experience", i18n.language);
---

<Layout bgColor="bg-iris-wash" title={`${experience.role} — Ricardo Sánchez Saldivar`}>
    <Section id="professional-experience-detail" bgColor="bg-iris-wash">
        <a href={experienceHref} class="self-start text-sm text-pine underline mb-12">
            ← {i18n.t("common:pages.professional_experience")}
        </a>
        <div class="flex flex-col w-full">
            <div class="reveal w-full md:grid md:grid-cols-12 md:items-start">
                <ExperienceAstroComponent
                    role={experience.role}
                    company={experience.company}
                    years={experience.years}
                    projects={experience.projects}
                    additionalActivities={experience.additionalActivities}
                />
            </div>
        </div>
    </Section>
</Layout>
