---
import i18n from "i18next";
import { buildStaticPaths } from "astro-react-i18next/utils";

import TitleAstroComponent from "../../components/title.astro";
import SectionAstroComponent from "../../components/section.astro";

export function getStaticPaths() {
    return buildStaticPaths();
}

interface EducationItem {
    title: string;
    institution: string;
    /** Optional, left empty for entries without a place. */
    location: string;
    period: string;
}

const educationItems = i18n.t("common:education.education-items", {
    returnObjects: true,
}) as EducationItem[];

interface LanguageItem {
    language: string;
    proficiency: string;
}

const languageItems = i18n.t("common:education.language-items", {
    returnObjects: true,
}) as LanguageItem[];
---

<SectionAstroComponent id="education-and-certification" bgColor="bg-paper">
    <TitleAstroComponent title={i18n.t("common:pages.education_and_certification")} />

    {/* Two cells, sized to the two lists. Cards earn their keep only here. */}
    <div class="grid w-full grid-cols-1 gap-6 md:grid-cols-12 md:items-start">
        <div class="reveal md:col-span-7" style="--index: 0">
            <div class="card flex h-full flex-col gap-4">
                <h3 class="text-xl font-bold text-black-tertiary">
                    {i18n.t("common:education.education-label")}
                </h3>

                <div class="flex flex-col gap-4">
                    {
                        educationItems.map((item) => (
                            <div class="flex justify-between items-baseline gap-4">
                                <div>
                                    <h4 class="text-[15px] font-bold text-black-tertiary">
                                        {item.title}
                                    </h4>
                                    <div class="text-[13px] text-black-secondary">
                                        {item.institution}
                                        {item.location && ` · ${item.location}`}
                                    </div>
                                </div>
                                <span class="text-xs text-iris">
                                    {item.period}
                                </span>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>

        <div class="reveal md:col-span-5" style="--index: 1">
            <div class="card flex h-full flex-col gap-4">
                <h3 class="text-xl font-bold text-black-tertiary">
                    {i18n.t("common:education.languages-label")}
                </h3>

                <div class="flex flex-wrap gap-1.5">
                    {
                        languageItems.map((item) => (
                            <span class="tag bg-iris-soft text-iris">
                                {`${item.language} - ${item.proficiency}`}
                            </span>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</SectionAstroComponent>
