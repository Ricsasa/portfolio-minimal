---
import i18n from "i18next";
import { buildStaticPaths } from "astro-react-i18next/utils";

import TitleAstroComponent from "../../components/title.astro";
import SectionAstroComponent from "../../components/section.astro";
import ProjectAstroComponent from "../../components/project.astro";
import type { Project } from "../../components/project.astro";

export function getStaticPaths() {
    return buildStaticPaths();
}

const projects = i18n.t("projects:projects", {
    returnObjects: true,
    ns: "projects",
}) as Project[];
---

<SectionAstroComponent id="selected-work" bgColor="bg-paper-deep">
    <TitleAstroComponent title={i18n.t("common:pages.selected_work")} />
    <div class="flex flex-col gap-20 md:gap-28 w-full">
        {
            projects.map((project, index) => (
                <div
                    class="reveal w-full md:grid md:grid-cols-12 md:items-start"
                    style={`--index: ${index}`}
                >
                    <ProjectAstroComponent
                        title={project.title}
                        brief_description={project.brief_description}
                        full_description={project.full_description}
                        category={project.category}
                        year={project.year}
                        href={project.href}
                        cta={project.cta}
                        technologies={project.technologies}
                        screenshots-prefix={project["screenshots-prefix"]}
                        compact
                    />
                </div>
            ))
        }
    </div>
</SectionAstroComponent>
