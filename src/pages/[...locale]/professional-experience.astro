---
import i18n from "i18next";
import { buildStaticPaths } from "astro-react-i18next/utils";

import TitleAstroComponent from "../../components/title.astro";
import SectionAstroComponent from "../../components/section.astro";
import ExperienceAstroComponent from "../../components/experience.astro";
import type { Experience } from "../../components/experience.astro";

export function getStaticPaths() {
    return buildStaticPaths();
}

/** Entries live in public/locales/<locale>/professional-experiences.json. */
const experienceKeys = ["sabbatical", "salesloft", "tiempo", "epam"] as const;
const experiences = experienceKeys.map(
    (key) =>
        i18n.t(`professional-experiences:${key}`, {
            returnObjects: true,
            ns: "professional-experiences",
        }) as Experience,
);
---

<SectionAstroComponent id="professional-experience" bgColor="bg-paper">
    <TitleAstroComponent title={i18n.t("common:pages.professional_experience")} />
    <div class="flex flex-col gap-12 md:gap-0 w-full">
        {
            experiences.map((experience, index) => (
                <div
                    class="reveal w-full md:grid md:grid-cols-12 md:items-start"
                    style={`--index: ${index}`}
                >
                    <ExperienceAstroComponent
                        role={experience.role}
                        company={experience.company}
                        years={experience.years}
                        projects={experience.projects}
                        additionalActivities={experience.additionalActivities}
                        slug={experienceKeys[index]}
                        compact
                    />
                </div>
            ))
        }
    </div>
</SectionAstroComponent>
