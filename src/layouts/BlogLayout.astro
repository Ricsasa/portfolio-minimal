---
import Layout from "./Layout.astro";

/**
 * Thin wrapper around `Layout.astro` for a single blog post: adds the post
 * header (title, date, tags) and a prose wrapper around `<slot />`, then
 * passes SEO/OG props straight through. `bgColor`/`accentColor` are left as
 * plain pass-through props — final blog visual design happens separately.
 */
interface Props {
    title: string;
    description: string;
    pubDate: Date;
    updatedDate?: Date;
    tags?: string[];
    ogImage?: string;
    canonicalURL?: string;
    bgColor?: string;
    accentColor?: string;
}

const {
    title,
    description,
    pubDate,
    updatedDate,
    tags = [],
    ogImage,
    canonicalURL,
    bgColor,
    accentColor,
} = Astro.props;

const dateFormatter = new Intl.DateTimeFormat(undefined, {
    year: "numeric",
    month: "long",
    day: "numeric",
});
---

<Layout
    title={title}
    description={description}
    ogImage={ogImage}
    ogType="article"
    canonicalURL={canonicalURL}
    bgColor={bgColor}
    accentColor={accentColor}
>
    <article
        class="mx-auto w-full max-w-9xl px-8 py-24 md:px-48 md:py-32"
        style={accentColor ? `--section-accent: var(--color-${accentColor})` : undefined}
    >
        <header class="mb-12 flex flex-col gap-4 border-b border-(--section-accent) pb-6">
            <h1 class="font-sans text-4xl font-bold tracking-[-0.03em] md:text-5xl">
                {title}
            </h1>
            <div class="flex flex-wrap items-center gap-3 text-sm text-black-secondary">
                <time datetime={pubDate.toISOString()}>
                    {dateFormatter.format(pubDate)}
                </time>
                {
                    updatedDate && (
                        <span>
                            · updated {dateFormatter.format(updatedDate)}
                        </span>
                    )
                }
            </div>
            {
                tags.length > 0 && (
                    <div class="flex flex-wrap gap-1.5">
                        {tags.map((tag) => (
                            <span class="tag">{tag}</span>
                        ))}
                    </div>
                )
            }
        </header>

        <div class="font-serif flex flex-col gap-6 text-black-tertiary">
            <slot />
        </div>
    </article>
</Layout>
