---
import "../styles/global.css";

import i18n from "i18next";

import { buildStaticPaths } from "astro-react-i18next/utils";
import { Font } from "astro:assets";

import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import Section from "../components/section.astro";

export function getStaticPaths() {
	return buildStaticPaths();
}

interface Props {
	bgColor?: string;
	accentColor?: string;
	title?: string;
	description?: string;
	ogImage?: string;
	ogType?: string;
	canonicalURL?: string;
}

const { bgColor = "bg-custom-yellow-100" } = Astro.props;
const { accentColor = "custom-yellow-300" } = Astro.props;
const {
	title = "Ricardo Sanchez Saldivar",
	description,
	ogImage,
	ogType = "website",
	canonicalURL = Astro.url.href,
} = Astro.props;
---

<!doctype html>
<html lang={i18n.language} class="scroll-smooth!">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		{/* Set before first paint so revealed content never flashes in. */}
		<script is:inline>
			document.documentElement.classList.add("js-reveal");
		</script>

		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		<link rel="canonical" href={canonicalURL} />

		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalURL} />
		{ogImage && <meta property="og:image" content={ogImage} />}
		<meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />

		<Font cssVariable="--font-literata" preload />
		<Font cssVariable="--font-nunito" preload />
		<Font cssVariable="--font-share-tech" preload />
	</head>
	<body class:list={[bgColor]}>
		<Header accentColor={accentColor} />
		<main>
			<slot />
		</main>
		<Section bgColor={bgColor} accentColor={accentColor}>
			<Footer />
		</Section>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		min-height: 100vh;
		min-height: 100dvh;
	}
</style>

<script>
	import { initCardAnimations } from "../scripts/cardAnimation";
	import { initMenuScrollSpy } from "../scripts/menuScrollSpy";
	import { initMobileMenu } from "../scripts/mobileMenu";
	import { initHeaderScroll } from "../scripts/headerScroll";

	initCardAnimations();
	initMenuScrollSpy();
	initMobileMenu();
	initHeaderScroll();
</script>
