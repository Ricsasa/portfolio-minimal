---
import "../styles/global.css";

import i18n from "i18next";

import { buildStaticPaths } from "astro-react-i18next/utils";
import { Font } from "astro:assets";

import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import Section from "../components/section.astro";

export function getStaticPaths() {
	return buildStaticPaths();
}

interface Props {
	bgColor?: string;
	accentColor?: string;
	title?: string;
	description?: string;
	ogImage?: string;
	ogType?: string;
	canonicalURL?: string;
}

const { bgColor = "bg-custom-yellow-100" } = Astro.props;
const { accentColor = "custom-yellow-300" } = Astro.props;
const {
	title = "Ricardo Sanchez Saldivar",
	description,
	ogImage,
	ogType = "website",
	canonicalURL = Astro.url.href,
} = Astro.props;
---

<!doctype html>
<html lang={i18n.language} class="scroll-smooth!">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		{/* Set before first paint so revealed content never flashes in. */}
		<script is:inline>
			document.documentElement.classList.add("js-reveal");
		</script>

		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		<link rel="canonical" href={canonicalURL} />
		<meta name="author" content="Ricardo Sánchez Saldivar" />

		<meta property="og:site_name" content="Ricardo Sánchez Saldivar" />
		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImage || "https://ricsasa.work/og-image.webp"} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="1111" />
		<meta property="og:image:type" content="image/webp" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@ricsasa" />
		<meta name="twitter:creator" content="@ricsasa" />
		<meta name="twitter:title" content={title} />
		{description && <meta name="twitter:description" content={description} />}
		<meta name="twitter:image" content={ogImage || "https://ricsasa.work/og-image.webp"} />

		<Font cssVariable="--font-literata" preload />
		<Font cssVariable="--font-nunito" preload />
		<Font cssVariable="--font-share-tech" preload />

		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "Person",
			"name": "Ricardo Sánchez Saldivar",
			"jobTitle": "Full Stack Engineer",
			"url": "https://ricsasa.work",
			"email": "ricsasa201@gmail.com",
			"image": "https://ricsasa.work/og-image.webp",
			"sameAs": [
				"https://linkedin.com/in/ricardosanchezsaldivar",
				"https://github.com/ricsasa",
				"https://twitter.com/ricsasa"
			],
			"knowsAbout": [
				"Full Stack Development",
				"Web Development",
				"React",
				"Node.js",
				"TypeScript",
				"Astro",
				"Tailwind CSS"
			]
		}
		</script>
	</head>
	<body class:list={[bgColor]}>
		<Header accentColor={accentColor} />
		<main>
			<slot />
		</main>
		<Section bgColor={bgColor} accentColor={accentColor}>
			<Footer />
		</Section>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		min-height: 100vh;
		min-height: 100dvh;
	}
</style>

<script>
	import { initCardAnimations } from "../scripts/cardAnimation";
	import { initMenuScrollSpy } from "../scripts/menuScrollSpy";
	import { initMobileMenu } from "../scripts/mobileMenu";

	initCardAnimations();
	initMenuScrollSpy();
	initMobileMenu();
</script>
